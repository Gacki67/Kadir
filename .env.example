############################################################################
#  KADIR BARBER — VARIABLES D'ENVIRONNEMENT
#
#  1. Copiez ce fichier :            cp .env.example .env
#  2. Renseignez vos vraies valeurs dans .env
#  3. Ne committez JAMAIS le fichier .env (il est deja dans .gitignore)
#
#  Le site fonctionne des le depart avec uniquement DATABASE_URL,
#  ADMIN_SESSION_SECRET, ADMIN_EMAIL et ADMIN_PASSWORD.
#  Sans cles e-mail/SMS, les notifications s'affichent dans les logs du
#  serveur (mode developpement) et les reservations fonctionnent normalement.
############################################################################


# ─────────────────────────────────────────────────────────────────────────
#  BASE DE DONNEES (obligatoire)
# ─────────────────────────────────────────────────────────────────────────
# PostgreSQL. En local :
#   postgresql://postgres:postgres@localhost:5432/kadir_barber
# Sur Neon / Supabase, copiez la chaine de connexion fournie
# (pensez a ajouter ?sslmode=require).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kadir_barber"

# Connexion DIRECTE (sans pooler), utilisee par les migrations.
# - En local : identique a DATABASE_URL.
# - Sur Neon : la meme URL SANS le suffixe "-pooler" dans le nom d'hote.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/kadir_barber"


# ─────────────────────────────────────────────────────────────────────────
#  SITE (obligatoire en production)
# ─────────────────────────────────────────────────────────────────────────
# URL publique complete, sans barre oblique finale.
# Sert a construire les liens des e-mails, le sitemap et les balises SEO.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"


# ─────────────────────────────────────────────────────────────────────────
#  ESPACE ADMINISTRATEUR (obligatoire)
# ─────────────────────────────────────────────────────────────────────────
# Secret de signature des sessions — 32 caracteres minimum.
# Generez-le avec :  openssl rand -base64 32
ADMIN_SESSION_SECRET="remplacez-moi-par-une-chaine-aleatoire-de-32-caracteres-minimum"

# Identifiant de connexion a /admin
ADMIN_EMAIL="admin@kadirbarber.fr"

# Mot de passe — DEUX possibilites :
#
#  (A) RECOMMANDE EN PRODUCTION — hachage bcrypt.
#      Generez-le avec :  npm run hash-password -- "VotreMotDePasse"
# ADMIN_PASSWORD_HASH="$2a$12$..."
#
#  (B) PRATIQUE EN LOCAL — mot de passe en clair.
#      Ignore si ADMIN_PASSWORD_HASH est defini.
ADMIN_PASSWORD="changez-ce-mot-de-passe"


# ─────────────────────────────────────────────────────────────────────────
#  E-MAILS — choisissez UN fournisseur
# ─────────────────────────────────────────────────────────────────────────
# Adresse d'expedition. Le domaine doit etre verifie chez votre fournisseur.
EMAIL_FROM="Kadir Barber <contact@kadirbarber.fr>"

# --- Option 1 : Resend (recommande) — https://resend.com
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"

# --- Option 2 : Brevo — https://brevo.com
#     La meme cle sert aussi aux SMS (voir plus bas).
# BREVO_API_KEY="xkeysib-xxxxxxxxxxxxxxxxxxxx"

# --- Option 3 : SMTP classique (necessite `npm install nodemailer`)
# SMTP_HOST="smtp.exemple.fr"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="contact@kadirbarber.fr"
# SMTP_PASSWORD="votre-mot-de-passe-smtp"


# ─────────────────────────────────────────────────────────────────────────
#  SMS — choisissez UN fournisseur
# ─────────────────────────────────────────────────────────────────────────
# --- Option 1 : Twilio — https://twilio.com
# TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_PHONE_NUMBER="+33757000000"
#   Alternative au numero emetteur : un Messaging Service Twilio
# TWILIO_MESSAGING_SERVICE_SID="MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- Option 2 : Brevo SMS (reutilise BREVO_API_KEY ci-dessus)
#     Nom de l'expediteur : 11 caracteres alphanumeriques maximum.
# BREVO_SMS_SENDER="KadirBarber"


# ─────────────────────────────────────────────────────────────────────────
#  RAPPELS AUTOMATIQUES 24 H AVANT
# ─────────────────────────────────────────────────────────────────────────
# Secret protegeant la route /api/cron/reminders.
# Generez-le avec :  openssl rand -hex 32
# Sur Vercel, ajoutez-le aussi dans les variables du projet : les Cron Jobs
# Vercel envoient automatiquement l'en-tete Authorization correspondante.
CRON_SECRET="remplacez-moi-par-un-secret-aleatoire"
